---
const benefits = [
  ['01', 'Start with what you know', 'The hallway, the kitchen window, the door by the stairs. Draw the place you already recognize.'],
  ['02', 'Keep the details in one view', 'Add doors, windows and everyday fixtures. Give the rooms names and adjust their measurements.'],
  ['03', 'Take the picture with you', 'Export an SVG drawing to open or print elsewhere. Save an editable JSON plan to continue another day.'],
];
---
<section class="benefits frame" aria-labelledby="benefits-title" data-reveal>
  <div class="section-intro"><p class="eyebrow caption-3">A little perspective</p><h2 id="benefits-title" class="heading-2">You live there.<br />You just haven't drawn it yet.</h2><p class="body-3">You do not need a blueprint to start making sense of a familiar place.</p></div>
  <div class="benefit-grid">
    {benefits.map(([number, title, body]) => <article class="benefit-card"><span class="benefit-number caption-3">{number}</span><h3 class="heading-6">{title}</h3><p class="body-6">{body}</p></article>)}
  </div>
</section>
