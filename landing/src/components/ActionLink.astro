---
import Icon from './Icon.astro';
const { class: className = '', size = 'md' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<a href={`${base}app/`} data-editor-link class={`button button-${size} ${className}`}>
  <span>Draw your space</span><Icon name="arrow-up-right" />
</a>
